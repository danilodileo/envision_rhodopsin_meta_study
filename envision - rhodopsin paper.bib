@article{koblizek_ecology_2015,
	title = {Ecology of aerobic anoxygenic phototrophs in aquatic environments},
	volume = {39},
	issn = {1574-6976},
	url = {https://academic.oup.com/femsre/article-lookup/doi/10.1093/femsre/fuv032},
	doi = {10.1093/femsre/fuv032},
	abstract = {Recognition of the environmental role of photoheterotrophic bacteria has been one of the main themes of aquatic microbiology over the last 15 years. Aside from cyanobacteria and proteorhodopsin-containing bacteria, aerobic anoxygenic phototrophic ({AAP}) bacteria are the third most numerous group of phototrophic prokaryotes in the ocean. This functional group represents a diverse assembly of species which taxonomically belong to various subgroups of Alpha-, Beta- and Gammaproteobacteria. {AAP} bacteria are facultative photoheterotrophs which use bacteriochlorophyll-containing reaction centers to harvest light energy. The light-derived energy increases their bacterial growth efficiency, which provides a competitive advantage over heterotrophic species. Thanks to their enzymatic machinery {AAP} bacteria are active, rapidly growing organisms which contribute significantly to the recycling of organic matter. This chapter summarizes the current knowledge of the ecology of {AAP} bacteria in aquatic environments, implying their specific role in the microbial loop.},
	pages = {854--870},
	number = {6},
	journaltitle = {{FEMS} Microbiology Reviews},
	shortjournal = {{FEMS} Microbiology Reviews},
	author = {Koblížek, Michal},
	editor = {Brussaard, Corina},
	urldate = {2025-12-05},
	date = {2015-11},
	langid = {english},
	file = {PDF:/Users/dadiaa/Zotero/storage/43KWCU4Z/Koblížek - 2015 - Ecology of aerobic anoxygenic phototrophs in aquatic environments.pdf:application/pdf},
}

