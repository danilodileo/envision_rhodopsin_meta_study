	langid = {english},
	file = {Moran et al. - 2007 - Ecological Genomics of Marine Roseobacters.pdf:/Users/dadiaa/Zotero/storage/ZYSC5FRM/Moran et al. - 2007 - Ecological Genomics of Marine Roseobacters.pdf:application/pdf},
