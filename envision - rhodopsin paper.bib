@article{koedooder_role_2018,
	title = {The Role of the Glyoxylate Shunt in the Acclimation to Iron Limitation in Marine Heterotrophic Bacteria},
	volume = {5},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2296-7745},
	url = {https://www.frontiersin.org/article/10.3389/fmars.2018.00435/full},
	doi = {10.3389/fmars.2018.00435},
	abstract = {Iron (Fe) is an essential element for marine microbial growth but is present in trace amounts ({\textless}0.1 {nM}) in surface waters of the ocean. In heterotrophic bacteria, Felimitation particularly impacts {ATP} production as Fe is an essential co-factor of enzymes involved in the electron-transport chain as well as the tricarboxylic acid ({TCA}) cycle. Fe-limitation can therefore drastically reduce both bacterial growth and respiration, consequently affecting the efﬁciency of organic carbon remineralization. Heterotrophic bacteria possess various strategies to cope with Fe-limitation. In the present study we tested the hypothesis that the induction of the glyoxylate shunt can represent one such strategy. Genetic approaches were used to gain insight into the potential role the glyoxylate shunt may have in alleviating Fe-stress using the gammaproteobacterium, Photobacterium angustum S14. A recombinant bioluminescent reporter of P. angustum S14 (icl-luc) revealed a strong and signiﬁcant increase in the expression of isocitrate lyase (icl), a key enzyme within the glyoxylate shunt, when cells were subjected to strong Fe-limitation. Although the growth and respiration rates decreased for both the wildtype and an icl knockout mutant ( icl) under strong Fe-limitation, they were ±30\% lower for icl as compared to the wildtype. Complementation of icl restored the growth and respiration rates to those observed in the wildtype, further conﬁrming the importance of the glyoxylate shunt under strong Fe-limitation. Due to the ubiquitous nature of the glyoxylate shunt within marine bacteria, our results lead us to propose this pathway as an important acclimation strategy for marine heterotrophic bacteria that are subjected to Fe-limitation.},
	journaltitle = {Frontiers in Marine Science},
	shortjournal = {Front. Mar. Sci.},
	publisher = {Frontiers Media {SA}},
	author = {Koedooder, Coco and Guéneuguès, Audrey and Van Geersdaële, Rémy and Vergé, Valérie and Bouget, François-Yves and Labreuche, Yannick and Obernosterer, Ingrid and Blain, Stéphane},
	urldate = {2025-07-22},
	date = {2018-11-21},
	langid = {english},
	file = {Koedooder et al. - 2018 - The Role of the Glyoxylate Shunt in the Acclimatio.pdf:/Users/dadiaa/Zotero/storage/VPF2H9KS/Koedooder et al. - 2018 - The Role of the Glyoxylate Shunt in the Acclimatio.pdf:application/pdf},
}

@article{dolan_glyoxylate_2018,
	title = {The Glyoxylate Shunt, 60 Years On},
	volume = {72},
	issn = {0066-4227, 1545-3251},
	url = {https://www.annualreviews.org/doi/10.1146/annurev-micro-090817-062257},
	doi = {10.1146/annurev-micro-090817-062257},
	abstract = {2017 marks the 60th anniversary of Krebs’ seminal paper on the glyoxylate shunt (and coincidentally, also the 80th anniversary of his discovery of the citric acid cycle). Sixty years on, we have witnessed substantial developments in our understanding of how flux is partitioned between the glyoxylate shunt and the oxidative decarboxylation steps of the citric acid cycle. The last decade has shown us that the beautifully elegant textbook mechanism that regulates carbon flux through the shunt in E. coli is an oversimplification of the situation in many other bacteria. The aim of this review is to assess how this new knowledge is impacting our understanding of flux control at the {TCA} cycle/glyoxylate shunt branch point in a wider range of genera, and to summarize recent findings implicating a role for the glyoxylate shunt in cellular functions other than metabolism.},
	pages = {309--330},
	number = {1},
	journaltitle = {Annual Review of Microbiology},
	shortjournal = {Annu. Rev. Microbiol.},
	publisher = {Annual Reviews},
	author = {Dolan, Stephen K. and Welch, Martin},
	urldate = {2025-07-22},
	date = {2018-09-08},
	langid = {english},
	file = {Dolan and Welch - 2018 - The Glyoxylate Shunt, 60 Years On.pdf:/Users/dadiaa/Zotero/storage/AY79EGZZ/Dolan and Welch - 2018 - The Glyoxylate Shunt, 60 Years On.pdf:application/pdf},
}

@article{beier_transcriptional_2015,
	title = {The transcriptional regulation of the glyoxylate cycle in {\textless}span style="font-variant:small-caps;"{\textgreater}{SAR}{\textless}/span{\textgreater}11 in response to iron fertilization in the {\textless}span style="font-variant:small-caps;"{\textgreater}S{\textless}/span{\textgreater}outhern {\textless}span style="font-variant:small-caps;"{\textgreater}O{\textless}/span{\textgreater}cean},
	volume = {7},
	rights = {http://onlinelibrary.wiley.com/{termsAndConditions}\#vor},
	issn = {1758-2229, 1758-2229},
	url = {https://sfamjournals.onlinelibrary.wiley.com/doi/10.1111/1758-2229.12267},
	doi = {10.1111/1758-2229.12267},
	shorttitle = {The transcriptional regulation of the glyoxylate cycle in {\textless}span style="font-variant},
	abstract = {{SummaryThe} tricarboxylic acid ({TCA}) cycle is a central metabolic pathway that is present in all aerobic organisms and initiates the respiration of organic material. The glyoxylate cycle is a variation of the {TCA} cycle, where organic material is recycled for subsequent assimilation into cell material instead of being released as carbon dioxide. Despite the importance for the fate of organic matter, the environmental factors that induce the glyoxylate cycle in microbial communities remain poorly understood. In this study, we assessed the expression of isocitrate lyase, the enzyme that induces the switch to the glyoxylate cycle, of the ubiquitous {SAR}11 clade in response to natural iron fertilization in the Southern Ocean. The cell‐specific transcriptional regulation of the glyoxylate cycle, as determined by the ratio between copy numbers of isocitrate lyase gene transcripts and isocitrate genes, was consistently lower in iron fertilized than in high‐nutrient, low chlorophyll waters (by 2.4‐ to 16.5‐fold). {SAR}11 cell‐specific isocitrate lyase gene transcription was negatively correlated to chlorophyll a, and bulk bacterial heterotrophic metabolism. We conclude that the glyoxylate cycle is a metabolic strategy for {SAR}11 that is highly sensitive to the degree of iron and carbon limitation in the marine environment.},
	pages = {427--434},
	number = {3},
	journaltitle = {Environmental Microbiology Reports},
	shortjournal = {Environ Microbiol Rep},
	publisher = {Wiley},
	author = {Beier, Sara and Gálvez, María J. and Molina, Veronica and Sarthou, Géraldine and Quéroué, Fabien and Blain, Stephane and Obernosterer, Ingrid},
	urldate = {2025-07-22},
	date = {2015-06},
	langid = {english},
	file = {Beier et al. - 2015 - The transcriptional regulation of the glyoxylate c.pdf:/Users/dadiaa/Zotero/storage/VDQUJ5JM/Beier et al. - 2015 - The transcriptional regulation of the glyoxylate c.pdf:application/pdf},
}

@article{riemann_widespread_2002,
	title = {Widespread            \textit{N}            -Acetyl-            {\textless}span style="font-variant:small-caps;"{\textgreater}d{\textless}/span{\textgreater}            -Glucosamine Uptake among Pelagic Marine Bacteria and Its Ecological Implications},
	volume = {68},
	rights = {https://journals.asm.org/non-commercial-tdm-license},
