@article{delmont_single-amino_2019,
	title = {Single-amino acid variants reveal evolutionary processes that shape the biogeography of a global {SAR}11 subclade},
	volume = {8},
	rights = {http://creativecommons.org/licenses/by/4.0/},
	issn = {2050-084X},
	url = {https://elifesciences.org/articles/46497},
	doi = {10.7554/eLife.46497},
	abstract = {Members of the {SAR}11 order Pelagibacterales dominate the surface oceans. Their extensive diversity challenges emerging operational boundaries defined for microbial 'species' and complicates efforts of population genetics to study their evolution. Here, we employed single-amino acid variants ({SAAVs}) to investigate ecological and evolutionary forces that maintain the genomic heterogeneity within ubiquitous {SAR}11 populations we accessed through metagenomic read recruitment using a single isolate genome. Integrating amino acid and protein biochemistry with metagenomics revealed that systematic purifying selection against deleterious variants governs non-synonymous variation among very closely related populations of {SAR}11. {SAAVs} partitioned metagenomes into two main groups matching large-scale oceanic current temperatures, and six finer proteotypes that connect distant oceanic regions. These findings suggest that environmentally-mediated selection plays a critical role in the journey of cosmopolitan surface ocean microbial populations, and the idea ‘everything is everywhere but the environment selects’ has credence even at the finest resolutions.},
	pages = {e46497},
	journaltitle = {{eLife}},
	author = {Delmont, Tom O and Kiefl, Evan and Kilinc, Ozsel and Esen, Ozcan C and Uysal, Ismail and Rappé, Michael S and Giovannoni, Steven and Eren, A Murat},
	urldate = {2026-01-18},
	date = {2019-09-03},
	langid = {english},
	file = {PDF:/Users/dadiaa/Zotero/storage/LQ5YK38Y/Delmont et al. - 2019 - Single-amino acid variants reveal evolutionary processes that shape the biogeography of a global SAR.pdf:application/pdf},
}

