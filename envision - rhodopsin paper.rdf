            <dcterms:URI>
                <rdf:value>https://journals.asm.org/doi/10.1128/AEM.00137-18</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-07-31 09:28:37</dcterms:dateSubmitted>
        <bib:pages>e00137-18</bib:pages>
    </bib:Article>
