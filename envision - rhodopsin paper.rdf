            <dcterms:URI>
               <rdf:value>https://www.nature.com/articles/sdata2018130</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-12-20 09:53:48</dcterms:dateSubmitted>
        <bib:pages>180130</bib:pages>
    </bib:Article>
